<?xml version="1.0" ?>
<project source="5.0.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar/>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <comp lib="0" loc="(100,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="STATE[2:0]"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="4" loc="(260,200)" name="ROM">
      <a name="addrWidth" val="3"/>
      <a name="dataWidth" val="9"/>
      <a name="contents">addr/data: 3 9
0 061
1 091
2 0C9
3 10C
4 14A
5 009
6 009
7 009
</a>
    </comp>
    <comp lib="0" loc="(430,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="D[2:0] + A_G,A_Y,A_R,B_G,B_Y,B_R"/>
      <a name="width" val="9"/>
    </comp>
    <comp lib="8" loc="(100,300)" name="Text">
      <a name="text" val="Moore traffic-light FSM lookup block. Input STATE[2:0]; output bus bits [8:6]=next state D2,D1,D0 and [5:0]=A_G,A_Y,A_R,B_G,B_Y,B_R. This is the combinational next-state/output block; connect a 3-bit D flip-flop state register with common clock and reset to make the complete sequential FSM."/>
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="valign" val="base"/>
    </comp>
    <wires>
      <wire from="(100,200)" to="(230,200)"/>
      <wire from="(290,200)" to="(430,200)"/>
    </wires>
  </circuit>
</project>
